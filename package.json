{
  "name": "child-learning-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @child-learning/web dev",
    "build": "pnpm --filter @child-learning/web build",
    "typecheck": "pnpm -r --if-present typecheck && pnpm typecheck:evals",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck:evals": "tsc -p evals/tsconfig.json",
    "eval:skills": "tsx evals/run.ts",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "mcp": "tsx packages/mcp-server/src/server.ts",
    "plugin:bundle": "tsx scripts/bundle-mcp.ts",
    "plugin:clean:claude": "node -e \"require('node:fs').rmSync('dist/plugin/claude', { recursive: true, force: true })\"",
    "plugin:validate": "pnpm plugin:bundle && go run github.com/asingamaneni/omniplug/cmd/omniplug@1da68b18cfbf74d7cdbc0ebae9416f06a8654676 validate -s plugin -t claude",
    "plugin:verify-output": "tsx scripts/verify-claude-plugin-output.ts",
    "brand:verify": "tsx scripts/verify-branding.ts",
    "plugin:build": "pnpm plugin:bundle && pnpm plugin:clean:claude && go run github.com/asingamaneni/omniplug/cmd/omniplug@1da68b18cfbf74d7cdbc0ebae9416f06a8654676 build -s plugin -o dist/plugin -t claude && pnpm plugin:verify-output",
    "verify:fast": "pnpm brand:verify && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm plugin:build",
    "verify": "pnpm verify:fast && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.25.12",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "5.0.0"
  }
}
