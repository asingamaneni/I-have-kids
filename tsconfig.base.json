{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@child-learning/contracts": ["packages/contracts/src/index.ts"],
      "@child-learning/domain": ["packages/domain/src/index.ts"],
      "@child-learning/database": ["packages/database/src/index.ts"],
      "@child-learning/storage": ["packages/storage/src/index.ts"],
      "@child-learning/rendering": ["packages/rendering/src/index.ts"],
      "@child-learning/demo": ["packages/demo/src/index.ts"]
    }
  }
}
