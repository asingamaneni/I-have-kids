    { "id": "main-idea-guided", "conceptId": "english.main-idea", "stage": "guided", "title": "Main idea", "objectives": ["Identify what a paragraph is mostly about."], "instructions": ["Read the paragraph. Choose the main idea."], "items": [{ "id": "main-idea-1", "conceptId": "english.main-idea", "kind": "selected-response", "content": "Bees visit flowers to gather nectar. As they move, they carry pollen from flower to flower. This helps many plants make seeds.", "prompt": "What is the paragraph mostly about?", "choices": ["how bees help plants", "how seeds become trees", "why flowers have colors"], "correctChoice": "how bees help plants", "difficulty": 5 }], "answerSpecs": { "main-idea-1": { "type": "choice", "expected": "how bees help plants" } }, "scoring": { "method": "exact" } },
    { "id": "text-evidence-guided", "conceptId": "english.text-evidence", "stage": "guided", "title": "Use text evidence", "objectives": ["Use one detail from a text to support an answer."], "instructions": ["Read the text. Write one supporting detail."], "items": [{ "id": "text-evidence-1", "conceptId": "english.text-evidence", "kind": "short-response", "content": "The trail was muddy after a night of rain. Lila wore boots so her feet stayed dry.", "prompt": "Which detail shows why Lila wore boots?", "expectedAnswers": ["the trail was muddy"], "normalize": "case-insensitive", "difficulty": 5 }], "answerSpecs": { "text-evidence-1": { "type": "text", "expected": "the trail was muddy", "normalize": "case-insensitive" } }, "scoring": { "method": "normalized-text" } },
    { "id": "paragraph-writing-guided", "conceptId": "english.paragraph-writing", "stage": "planned", "title": "Plan a paragraph", "objectives": ["Write a focused paragraph with supporting details."], "instructions": ["Write a topic sentence, two details, and an ending."], "items": [{ "id": "paragraph-1", "conceptId": "english.paragraph-writing", "kind": "extended-response", "prompt": "Explain a skill you have learned and how you improved.", "rubricId": "focused-paragraph-v1", "minimumLines": 5, "difficulty": 6 }], "answerSpecs": { "paragraph-1": { "type": "rubric", "rubricId": "focused-paragraph-v1", "requiresHumanReview": true } }, "scoring": { "method": "rubric" } },
    { "id": "habitats-guided", "conceptId": "science.habitats", "stage": "guided", "title": "Habitats", "objectives": ["Identify how a habitat meets an animal's needs."], "instructions": ["Read the question. Choose one answer."], "items": [{ "id": "habitat-1", "conceptId": "science.habitats", "kind": "selected-response", "prompt": "Which habitat gives a fish the water it needs?", "choices": ["a pond", "a desert", "a dry cave"], "correctChoice": "a pond", "difficulty": 4 }], "answerSpecs": { "habitat-1": { "type": "choice", "expected": "a pond" } }, "scoring": { "method": "exact" } },
    { "id": "food-chains-guided", "conceptId": "science.food-chains", "stage": "visual", "title": "Food chains", "objectives": ["Order a simple food chain."], "instructions": ["Write the numbers in food-chain order."], "items": [{ "id": "food-chain-1", "conceptId": "science.food-chains", "kind": "ordering", "prompt": "Put the food chain in order.", "options": ["grass", "rabbit", "hawk"], "correctOrder": [0, 1, 2], "difficulty": 5 }], "answerSpecs": { "food-chain-1": { "type": "sequence", "expected": [0, 1, 2] } }, "scoring": { "method": "sequence" } },
