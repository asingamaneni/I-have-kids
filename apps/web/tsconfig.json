{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@kindergarten/contracts": ["../../packages/contracts/src/index.ts"],
      "@kindergarten/domain": ["../../packages/domain/src/index.ts"],
      "@kindergarten/database": ["../../packages/database/src/index.ts"],
      "@kindergarten/storage": ["../../packages/storage/src/index.ts"],
      "@kindergarten/rendering": ["../../packages/rendering/src/index.ts"],
      "@kindergarten/demo": ["../../packages/demo/src/index.ts"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
